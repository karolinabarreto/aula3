                }
              }
            }
          }
        }
      }
    },
    "/api/tipos-ingresso/{id}": {
      "get": {
        "tags": [
          "Tipos de ingresso"
        ],
        "summary": "Buscar um tipo de ingresso pelo id",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Tipo de ingresso encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipoIngresso"
                }
              }
            }
          },
          "404": {
