  },
  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        }
      }
    },
    "schemas": {
      "FilmeEntrada": {
        "type": "object",
        "required": [
          "nome",
          "data_estreia",
          "data_saida",
          "duracao"
        ],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Duna: Parte 2"
          },
          "data_estreia": {
            "type": "string",
            "example": "01/03/2024",
            "description": "Formato dd/mm/aaaa"
          },
          "data_saida": {
            "type": "string",
            "example": "01/06/2024",
            "description": "Formato dd/mm/aaaa"
          },
          "duracao": {
            "type": "integer",
            "example": 166,
            "description": "Duração em minutos"
          },
          "cartaz": {
            "type": "string",
            "example": "/static/cartazes/duna-parte-2.svg",
            "description": "Opcional. URL (http/https) ou caminho em /static da imagem do cartaz, exibida no site."
          }
        }
      },
      "Filme": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              }
            }
          },
          {
            "$ref": "#/components/schemas/FilmeEntrada"
          }
        ]
      },
      "SalaEntrada": {
        "type": "object",
        "required": [
          "numero",
          "capacidade",
          "tipo"
        ],
        "properties": {
          "numero": {
            "type": "integer",
            "example": 1
          },
          "capacidade": {
            "type": "integer",
            "example": 50
          },
          "tipo": {
            "type": "string",
            "enum": [
              "2D",
              "3D"
            ],
            "example": "2D"
          }
        }
      },
      "Sala": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              }
            }
          },
          {
            "$ref": "#/components/schemas/SalaEntrada"
          }
        ]
      },
      "SessaoEntrada": {
        "type": "object",
        "required": [
          "sala_id",
          "filme_id",
          "data",
          "hora_inicio"
        ],
        "properties": {
          "sala_id": {
            "type": "integer",
            "example": 1
          },
          "filme_id": {
            "type": "integer",
            "example": 1
          },
          "data": {
            "type": "string",
            "example": "10/03/2024",
            "description": "Formato dd/mm/aaaa"
          },
          "hora_inicio": {
            "type": "integer",
            "example": 20,
            "description": "Hora de 0 a 23"
          }
        }
      },
      "Sessao": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              },
              "assentos": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "enum": [
                    0,
                    1
                  ]
                },
                "description": "Lista com um item por lugar da sala (0 = livre, 1 = ocupado), gerada automaticamente no cadastro com base na capacidade da sala.",
                "example": [
                  0,
                  0,
                  0,
                  0,
                  0
                ]
              }
            }
          },
          {
            "$ref": "#/components/schemas/SessaoEntrada"
          }
        ]
      },
      "TipoIngressoEntrada": {
        "type": "object",
        "required": [
          "tipo",
          "valor_ingresso"
        ],
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "2D",
              "3D"
            ],
            "example": "2D"
          },
          "valor_ingresso": {
            "type": "number",
            "format": "float",
            "example": 30.0
          }
        }
      },
      "TipoIngresso": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "example": 1
              }
            }
          },
          {
            "$ref": "#/components/schemas/TipoIngressoEntrada"
          }
        ]
      },
      "Mensagem": {
        "type": "object",
        "properties": {
          "mensagem": {
            "type": "string",
            "example": "Filme removido com sucesso."
          }
        }
      },
      "Erro": {
        "type": "object",
        "properties": {
          "erro": {
            "type": "string",
            "example": "Dados invalidos."
          }
        }
      }
    }
  }
}