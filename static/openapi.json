    "/api/sessoes": {
      "get": {
        "tags": [
          "Sessões"
        ],
        "summary": "Listar sessões",
        "parameters": [
          {
            "name": "data",
            "in": "query",
            "required": false,
            "description": "Filtrar por data (dd/mm/aaaa)",
            "schema": {
              "type": "string",
              "example": "10/03/2024"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de sessões",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Sessao"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Sessões"
        ],
        "summary": "Cadastrar uma sessão",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SessaoEntrada"
              }
            }
          }
        },
        "responses": {
