    "/api/tipos-ingresso": {
      "get": {
        "tags": [
          "Tipos de ingresso"
        ],
        "summary": "Listar tipos de ingresso",
        "responses": {
          "200": {
            "description": "Lista de tipos de ingresso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TipoIngresso"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Tipos de ingresso"
        ],
        "summary": "Cadastrar valor de ingresso por tipo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TipoIngressoEntrada"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tipo de ingresso criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TipoIngresso"
                }
              }
            }
          },
          "400": {
